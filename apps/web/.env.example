# Copy to .env.local. Vite only exposes variables prefixed with VITE_.

# The API. Defaults to the local serverless-offline stage, which is what
# `npm run dev:local -w services/api` serves.
VITE_API_BASE_URL=http://localhost:3000/dev

# Cognito, from the deployed stack's outputs (UserPoolId, UserPoolClientId).
# Leave these blank while working locally.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Development only: sign in with a local identity instead of Cognito, so the
# app works end to end with nothing deployed. Ignored in production builds —
# the branch is compiled out — and a token minted this way is rejected by the
# real API Gateway.
VITE_LOCAL_AUTH=true
